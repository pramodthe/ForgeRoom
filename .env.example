# Copy to `.env` for local development. Names and descriptions only — never commit values.

# Runtime
NODE_ENV=development
# HTTP bind address. Production hosts (including Render) must use 0.0.0.0.
HOST=0.0.0.0
# HTTP port. Production hosts inject PORT; do not hard-code it at runtime.
PORT=3000

# When true, the API process also starts the worker runtime. Set false to run apps/worker separately.
FORGEROOM_EMBED_WORKER=true

# Optional repository root for bundled API startup profile checks (defaults to cwd, then module path).
FORGEROOM_REPO_ROOT=

# Browser origin allowed for cookie mutations (Origin + CSRF checks).
APP_ORIGIN=http://localhost:5173

# Owner seed (P0-104). Production must use OWNER_PASSWORD_HASH only — never OWNER_PASSWORD or AUTH_BYPASS.
OWNER_USER_ID=user_owner
OWNER_EMAIL=owner@example.test
OWNER_DISPLAY_NAME=Owner
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
WORKSPACE_ID=workspace_1
WORKSPACE_NAME=ForgeRoom
WORKSPACE_SLUG=forgeroom
SESSION_COOKIE_NAME=fr_session
SESSION_TTL_SECONDS=43200
RECENT_AUTH_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Only trust X-Forwarded-For when the API sits behind a known reverse proxy.
TRUST_PROXY=
# Set to memory only for ephemeral local/dev without Postgres; default is Postgres auth_sessions.
AUTH_STORE=

# PostgreSQL (local compose default is documented in infra/compose.yaml).
# Local compose: postgres://forgeroom:forgeroom@127.0.0.1:5432/forgeroom
DATABASE_URL=

# Encrypts pending approval/question/resume payloads at rest (AES-256-GCM).
# Required in production (or OWNER_PASSWORD_HASH). Local/dev may omit and use a built-in default.
PAUSE_PAYLOAD_ENCRYPTION_SECRET=

# Object / artifact storage. P0-000 freezes local directory for development (`provider-fixtures/artifact-storage.candidate.json`).
# Demo durable adapter remains candidate until upload/download probe.
ARTIFACT_STORAGE_DIR=

# TrueForge harness (open-source). Local standalone mode needs no TrueForge API key —
# start with `npx @truefoundry/trueforge@latest` (default UI/API http://127.0.0.1:8790).
# ForgeRoom API health does not require TrueForge; P0-000/P0-201 probes do need a running harness.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
# Optional. Unused for local standalone TrueForge (no built-in API-key auth). Leave empty locally;
# only relevant if a reverse proxy / hosted deployment adds its own auth header.
TRUEFORGE_API_KEY=

# Model provider used by TrueForge for coworker presets (OD-005). P0 local choice: OpenAI.
# Configure the same key in TrueForge Settings → Models → OpenAI (or provider catalog entry).
# Never send this value to the browser.
OPENAI_API_KEY=
# Compatibility alias — prefer OPENAI_API_KEY. If set, probes may fall back to this name.
MODEL_PROVIDER_API_KEY=

# Composio hosted MCP (P0-301). Exact toolkit/tool slugs live under provider-fixtures/composio/.
# Pin the connected-account ID; commit only a redacted suffix. MCP URL/headers stay server-side only.
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=
FORGEROOM_E2E_GITHUB_OWNER=
FORGEROOM_E2E_GITHUB_REPOSITORY=
# Stable workspace service-user ID for hosted MCP sessions + direct-tool execute / fixture reset.
COMPOSIO_USER_ID=
# Auth config id for Connect Link reconnect (P0-304). Full id only in secrets.
COMPOSIO_AUTH_CONFIG_ID=
# Optional override (default https://backend.composio.dev).
# COMPOSIO_BASE_URL=

# Daytona settings for sandbox artifact probe (P0-000 checklist / P0-311).
DAYTONA_API_KEY=
