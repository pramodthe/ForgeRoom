exports[`controlled component 1440px visual baseline > ArtifactCard matches stable markup snapshot 1`] = `"<section class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-100 px-4 py-3"><h3 class="font-semibold text-zinc-950">Sandbox summary</h3></div><div class="flex h-28 items-center justify-center bg-violet-50 text-2xl font-semibold text-violet-700">Sandbox summary</div><div class="p-4"><p class="text-sm font-medium text-zinc-900">summary.md</p><p class="mt-1 text-xs text-zinc-500">Created by Operator · rev 1</p><a href="/api/artifacts/art_demo_001/download" class="mt-3 inline-flex text-xs font-medium text-violet-700 hover:text-violet-900">Download</a></div></section>"`;

exports[`controlled component 1440px visual baseline > BarOrLineChart matches stable markup snapshot 1`] = `"<section class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-100 px-4 py-3 flex items-start justify-between gap-3"><div><h3 class="font-semibold text-zinc-950">Synthetic record counts</h3><p class="mt-1 text-xs text-zinc-500">Bounded bar chart for the demo read path.</p></div><div class="inline-flex rounded-lg bg-zinc-100 p-0.5" role="group" aria-label="Chart view"><button type="button" class="rounded-md px-2.5 py-1 text-xs font-medium capitalize bg-white text-zinc-900 shadow-sm" aria-pressed="true">chart</button><button type="button" class="rounded-md px-2.5 py-1 text-xs font-medium capitalize text-zinc-500" aria-pressed="false">table</button></div></div><div class="p-4"><div class="space-y-3"><div role="img" aria-label="Record counts by status"><div class="grid grid-cols-[88px_1fr_36px] items-center gap-3"><span class="text-xs font-medium text-zinc-700">Point 1</span><div class="h-2.5 overflow-hidden rounded-full bg-zinc-100"><div class="h-full rounded-full bg-violet-500" style="width: 100%;"></div></div><span class="text-right text-xs tabular-nums text-zinc-500">1</span></div><div class="grid grid-cols-[88px_1fr_36px] items-center gap-3"><span class="text-xs font-medium text-zinc-700">Point 2</span><div class="h-2.5 overflow-hidden rounded-full bg-zinc-100"><div class="h-full rounded-full bg-sky-500" style="width: 100%;"></div></div><span class="text-right text-xs tabular-nums text-zinc-500">1</span></div></div><button type="button" class="text-xs font-medium text-violet-700 underline underline-offset-2">View data table</button></div></div><div class="flex items-center justify-between bg-zinc-50 px-4 py-2 text-[11px] text-zinc-500"><span>Count · bar chart</span></div></section>"`;

exports[`controlled component 1440px visual baseline > ChoiceForm matches stable markup snapshot 1`] = `"<form class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-100 px-4 py-3"><h3 class="font-semibold text-zinc-950">Filter synthetic records</h3><p class="mt-1 text-xs text-zinc-500">Bounded local filter only — no external mutation.</p></div><div class="space-y-4 p-4"><fieldset class="space-y-2"><legend class="text-sm font-medium text-zinc-900">Status<span class="text-red-600"> *</span></legend><p class="text-xs text-zinc-500">Show records with this status</p><div class="space-y-2"><label class="flex items-start gap-2 text-sm text-zinc-700"><input type="radio" name="status_filter"><span><span class="font-medium">Open</span></span></label><label class="flex items-start gap-2 text-sm text-zinc-700"><input type="radio" name="status_filter"><span><span class="font-medium">Ready</span></span></label><label class="flex items-start gap-2 text-sm text-zinc-700"><input type="radio" name="status_filter"><span><span class="font-medium">All</span></span></label></div></fieldset><fieldset class="space-y-2"><legend class="text-sm font-medium text-zinc-900">Show owner column</legend><label class="flex items-center gap-2 text-sm text-zinc-700"><input type="checkbox">Show owner column</label></fieldset></div><div class="border-t border-zinc-100 p-4"><div class="flex gap-2"><button type="submit" class="rounded-lg bg-zinc-900 px-3 py-2 text-xs font-semibold text-white disabled:opacity-60">Apply filter</button><button type="button" class="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-medium text-zinc-700">Reset</button></div></div></form>"`;

exports[`controlled component 1440px visual baseline > DataTable matches stable markup snapshot 1`] = `"<section class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-100 px-4 py-3"><h3 class="font-semibold text-zinc-950">Synthetic demo records</h3><p class="mt-1 text-xs text-zinc-500">Public/synthetic Composio read projected into the controlled table.</p><div class="mt-3 flex gap-2"><input placeholder="Filter rows" class="w-full rounded-lg border border-zinc-200 px-2.5 py-1.5 text-xs" aria-label="Filter table rows" type="search" value=""><button type="button" class="rounded-lg border border-zinc-200 px-2.5 py-1.5 text-xs text-zinc-600">Sort</button></div></div><div class="overflow-x-auto p-4"><table class="w-full text-left text-sm"><caption class="sr-only">Synthetic demo records</caption><thead class="text-xs text-zinc-500"><tr><th class="pb-2 font-medium" scope="col">Record</th><th class="pb-2 font-medium" scope="col">Status</th><th class="pb-2 font-medium" scope="col">Owner</th></tr></thead><tbody class="divide-y divide-zinc-100"><tr><td class="py-2 text-zinc-800">demo-rec-002</td><td class="py-2 text-zinc-800">ready</td><td class="py-2 text-zinc-800">fixture</td></tr><tr><td class="py-2 text-zinc-800">demo-rec-001</td><td class="py-2 text-zinc-800">open</td><td class="py-2 text-zinc-800">fixture</td></tr></tbody></table></div></section>"`;

