{
  "name": "forgeroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @forgeroom/api dev",
    "dev:web": "pnpm --filter @forgeroom/web dev",
    "dev:web:prototype": "pnpm --filter @forgeroom/web dev:prototype",
    "dev:worker": "pnpm --filter @forgeroom/worker dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --sort --if-present typecheck",
    "test": "pnpm -r --sort --if-present test",
    "build": "pnpm -r --sort --if-present build",
    "fixtures:seed": "pnpm --filter @forgeroom/test-fixtures seed",
    "fixtures:reset": "pnpm --filter @forgeroom/test-fixtures reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
